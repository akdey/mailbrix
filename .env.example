# Environment ("production" disables /docs, /redoc, /openapi.json)
ENV=development
APP_NAME=Email Relay Service

# Multi-App / Multi-Tenant Registry
# Recommended for Vercel: add one TENANT_<APP> env var per calling app (no need to edit existing ones).
# Generate keys locally with: python3 scripts/generate_key.py molat
TENANT_MOLAT={"key_hash":"replace-with-64-char-sha256-hex","from_name":"Molat","rate_limit_per_min":60}
# Optional combined JSON registry (merged with TENANT_* vars):
TENANTS_JSON=

# Security & Abuse Limits
REQUIRE_HMAC_SIGNATURE=false
HMAC_TOLERANCE_SECONDS=60
IP_RATE_LIMIT_PER_MIN=120
MAX_REQUEST_BYTES=5242880
MAX_RECIPIENTS=50
MAX_ATTACHMENTS=5
MAX_ATTACHMENT_BYTES=3145728

# Default SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_TIMEOUT=15

# Sender Defaults
DEFAULT_FROM_EMAIL=your-email@example.com
DEFAULT_FROM_NAME=No-Reply
