# Mailbrix Calling App Configuration
# Copy these variables into your calling app's .env (e.g., my-app)

# Base URL of your deployed Mailbrix instance (no trailing slash)
MAILBRIX_URL=https://mailbrix-akdey.vercel.app

# App identifier matching TENANT_<APP> / TENANTS_JSON on Mailbrix
MAILBRIX_APP_ID=my-app

# Raw API key generated from the Mailbrix UI or: python3 scripts/generate_key.py my-app
MAILBRIX_API_KEY=er_replace_with_raw_api_key

# Optional: HMAC signing secret (required if signing_secret is set on Mailbrix)
MAILBRIX_SIGNING_SECRET=replace_with_64_char_hex_signing_secret

# Optional: used only when running examples/send_email.py directly
TEST_TO_EMAIL=recipient@example.com
