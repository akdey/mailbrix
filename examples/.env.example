# Mailbridge Calling App Configuration
# Copy these variables into your calling app's .env (e.g., molat)

# Base URL of your deployed Mailbridge instance (no trailing slash)
MAILBRIDGE_URL=https://mailbridge-akdey.vercel.app

# App identifier matching TENANT_<APP> / TENANTS_JSON on Mailbridge
MAILBRIDGE_APP_ID=molat

# Raw API key printed by: python3 scripts/generate_key.py molat
MAILBRIDGE_API_KEY=er_replace_with_raw_api_key

# Optional: HMAC signing secret (required if signing_secret is set on Mailbridge)
MAILBRIDGE_SIGNING_SECRET=replace_with_64_char_hex_signing_secret

# Optional: used only when running examples/send_email.py directly
TEST_TO_EMAIL=recipient@example.com
